# ---- Oleificio Live — example environment (copy to .env, never commit real secrets) ----

# Database
DATABASE_URL=postgresql://oleificio:oleificio@localhost:5432/oleificio?schema=public

# Redis (cache, pub/sub, BullMQ)
REDIS_URL=redis://localhost:6379

# Object storage (S3-compatible / MinIO in dev)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=oleificio-docs
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# Auth
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
ACCESS_TOKEN_TTL=900          # seconds
REFRESH_TOKEN_TTL=1209600     # seconds (14 days)
ARGON2_MEMORY_KIB=19456
TEMP_PASSWORD_TTL_HOURS=72

# App
API_PORT=3001
WEB_PORT=3000
NODE_ENV=development
DEFAULT_LOCALE=it

# Notifications (providers configurable per tenant; leave blank to disable)
SMS_PROVIDER=
SMS_API_KEY=
SMTP_URL=

# Telemetry defaults
TELEMETRY_STALE_THRESHOLD_SECONDS=60
